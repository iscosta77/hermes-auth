{
    "name": "iscosta77/auth",
    "description": "Auth — login, registro e recuperacao de senha para PHP sem framework: password_hash nativo, sessao segura, mensagens pt/en/es. Integra com iscos/voodoo-2026 (banco) e iscosta77/validators.",
    "type": "library",
    "license": "MIT",
    "keywords": ["auth", "login", "autenticacao", "registro", "senha", "php"],
    "authors": [
        {"name": "Hermes Agent (Nous Research)", "role": "creator and maintainer"},
        {"name": "Ildefonso Costa", "email": "iscosta77@hotmail.com", "role": "publisher"}
    ],
    "require": {
        "php": "^8.2",
        "ext-password": "*",
        "ext-session": "*",
        "iscos/voodoo-2026": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../voodoo-2026",
            "options": {"versions": {"iscos/voodoo-2026": "1.0.0"}}
        },
        {
            "type": "path",
            "url": "../hermes-validators",
            "options": {"versions": {"iscosta77/validators": "1.0.2"}}
        }
    ],
    "autoload": {
        "psr-4": {
            "Hermes\\Auth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hermes\\Auth\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testdox"
    },
    "config": {
        "sort-packages": true
    }
}
